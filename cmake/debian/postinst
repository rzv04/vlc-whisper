#!/bin/sh
set -e

plugin_file="$(dpkg-query -L vlc-plugin-base 2>/dev/null | awk '/\/vlc\/plugins\/.*_plugin\.so$/ { print; exit }')"
cache_gen="$(dpkg-query -L libvlc-bin 2>/dev/null | awk '/\/vlc\/vlc-cache-gen$/ { print; exit }')"

if [ -n "$plugin_file" ] && [ -n "$cache_gen" ] && [ -x "$cache_gen" ]; then
  plugin_root="$(dirname "$(dirname "$plugin_file")")"
  "$cache_gen" "$plugin_root" >/dev/null 2>&1 || echo "vlc-whisper: warning: VLC plugin cache refresh failed" >&2
fi

# A reinstall is an explicit settings reset. Perform every user-controlled
# filesystem operation as the invoking user so symlinks cannot turn the
# privileged maintainer script into an ownership/write primitive.
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ] && command -v runuser >/dev/null 2>&1; then
  settings_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
  if [ -n "$settings_home" ]; then
    runuser -u "$SUDO_USER" -- env HOME="$settings_home" XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-}" sh -c '
      settings_dir="${XDG_CONFIG_HOME:-$HOME/.config}/vlc-whisper"
      umask 077
      mkdir -p "$settings_dir" || exit 0
      chmod 700 "$settings_dir" || exit 0
      rm -f "$settings_dir/settings.json" "$settings_dir/model-command" "$settings_dir/reset-settings"
      printf "%s\n" reset > "$settings_dir/reset-settings"
    ' || true
  fi
fi

exit 0