; ==============================================================================
; VLC-Whisper Windows Installer Script (NSIS 3.x)
; ==============================================================================

!include "MUI2.nsh"
!include "x64.nsh"
!include "FileFunc.nsh"
!include "LogicLib.nsh"
!define VW_PACKAGE_IS_GPU @VW_PACKAGE_IS_GPU@

; General Configuration
Name "VLC-Whisper AI Subtitles"
OutFile "@CMAKE_BINARY_DIR@/vlc-whisper-@PROJECT_VERSION@-win64-setup.exe"
InstallDir "$PROGRAMFILES64\VideoLAN\VLC"
InstallDirRegKey HKLM "Software\VideoLAN\VLC" "InstallDir"
RequestExecutionLevel admin
SetCompressor /SOLID lzma

; Version Information
VIProductVersion "@PROJECT_VERSION@.0"
VIAddVersionKey "ProductName" "VLC-Whisper"
VIAddVersionKey "CompanyName" "VLC-Whisper Project"
VIAddVersionKey "LegalCopyright" "Copyright (C) 2026 VLC-Whisper Contributors (MIT License)"
VIAddVersionKey "FileDescription" "Offline Whisper AI Real-Time Subtitle Plugin for VLC"
VIAddVersionKey "FileVersion" "@PROJECT_VERSION@.0"
VIAddVersionKey "ProductVersion" "@PROJECT_VERSION@.0"

; Variables
Var VLC_DIR
Var INSTALL_USER_APPDATA

; Interface Settings
!define MUI_ABORTWARNING
!define MUI_ICON "@CMAKE_SOURCE_DIR@/assets/vlc-whisper.ico"
!define MUI_UNICON "@CMAKE_SOURCE_DIR@/assets/vlc-whisper.ico"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_BITMAP "@CMAKE_SOURCE_DIR@/assets/installer-header.bmp"
!define MUI_HEADERIMAGE_RIGHT

; Installer Pages
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "@CMAKE_SOURCE_DIR@/LICENSE"
!define MUI_PAGE_CUSTOMFUNCTION_LEAVE DirectoryLeave
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

; Uninstaller Pages
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

; Language
!insertmacro MUI_LANGUAGE "English"

; ------------------------------------------------------------------------------
; Helper: Check if given exe is 64-bit via GetBinaryTypeW (SCS_64BIT_BINARY=6)
; ------------------------------------------------------------------------------
Function Is64BitPE
  Exch $0
  Push $1
  Push $2
  Push $3
  StrCpy $1 0
  System::Call 'kernel32::GetBinaryTypeW(w r0, *i .r2) i.r3'
  ${If} $3 != 0
    ${If} $2 == 6
      StrCpy $1 1
    ${EndIf}
  ${EndIf}
  StrCpy $0 $1
  Pop $3
  Pop $2
  Pop $1
  Exch $0
FunctionEnd

Function CheckVLC64Bit
  Push $0
  Push $1
  StrCpy $0 "$INSTDIR\vlc.exe"
  Push $0
  Call Is64BitPE
  Pop $1
  ${If} $1 == 0
    MessageBox MB_OK|MB_ICONSTOP "The selected VLC executable is not 64-bit.$\r$\nVLC-Whisper requires 64-bit VLC (vlc.exe must be x64). Please install 64-bit VLC or select its folder."
    Pop $1
    Pop $0
    Abort
  ${EndIf}
  Pop $1
  Pop $0
FunctionEnd

; Accept only VLC 3.x builds, whose plugin ABI this package targets.
Function CheckVLCVersion
  GetDLLVersion "$INSTDIR\vlc.exe" $0 $1
  ${If} ${Errors}
    MessageBox MB_OK|MB_ICONSTOP "Could not read the VLC version from '$INSTDIR\vlc.exe'."
    Abort
  ${EndIf}
  IntOp $2 $0 >> 16
  ${If} $2 != 3
    MessageBox MB_OK|MB_ICONSTOP "This installer targets VLC 3.x (64-bit). The selected VLC executable is version $0.$1."
    Abort
  ${EndIf}
FunctionEnd

; ------------------------------------------------------------------------------
; Directory Page Leave Callback (Validate VLC Installation Target)
; ------------------------------------------------------------------------------
Function DirectoryLeave
  ${IfNot} ${FileExists} "$INSTDIR\vlc.exe"
    MessageBox MB_OK|MB_ICONEXCLAMATION \
      "vlc.exe was not found in '$INSTDIR'.$\r$\nPlease select your VLC installation folder (the directory that contains vlc.exe)."
    Abort
  ${EndIf}
  Call CheckVLC64Bit
  Call CheckVLCVersion
FunctionEnd

; ------------------------------------------------------------------------------
; Initialization Function (Detect 64-bit Architecture and VLC Installation)
; ------------------------------------------------------------------------------
Function .onInit
  ${IfNot} ${RunningX64}
    MessageBox MB_OK|MB_ICONSTOP "VLC-Whisper requires a 64-bit version of Windows."
    Abort
  ${EndIf}

  SetRegView 64
  SetShellVarContext all

  ReadRegStr $VLC_DIR HKLM "Software\VideoLAN\VLC" "InstallDir"

  ${If} $VLC_DIR == ""
    ReadRegStr $VLC_DIR HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\VLC media player" "InstallLocation"
  ${EndIf}

  ${If} $VLC_DIR == ""
    StrCpy $VLC_DIR "$PROGRAMFILES64\VideoLAN\VLC"
  ${EndIf}

  ${IfNot} ${FileExists} "$VLC_DIR\vlc.exe"
    MessageBox MB_OKCANCEL|MB_ICONEXCLAMATION \
      "Could not automatically detect VLC 64-bit in '$VLC_DIR'.$\r$\nPlease select your VLC installation folder on the next screen." \
      IDOK proceed_install
    Abort
    proceed_install:
  ${Else}
    Push "$VLC_DIR\vlc.exe"
    Call Is64BitPE
    Pop $0
    ${If} $0 == 0
      MessageBox MB_OK|MB_ICONEXCLAMATION "Detected VLC at '$VLC_DIR' is not 64-bit. Installation will prompt for correct folder."
      StrCpy $VLC_DIR ""
    ${EndIf}
  ${EndIf}

  ${If} $VLC_DIR != ""
    StrCpy $INSTDIR $VLC_DIR
  ${EndIf}
FunctionEnd
; ------------------------------------------------------------------------------
; Query process state without parsing localized tasklist text. Any query failure is treated as running.
Function IsVLCProcessRunning
  nsExec::ExecToStack 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$$p=Get-Process -Name vlc -ErrorAction SilentlyContinue; if ($$null -eq $$p) { exit 1 } else { exit 0 }"'
  Pop $0
  Pop $1
  ${If} $0 == "0"
    Push 1
  ${ElseIf} $0 == "1"
    Push 0
  ${Else}
    Push 1
  ${EndIf}
FunctionEnd
; The uninstaller has a separate function namespace and cannot call installer functions.
Function un.IsVLCProcessRunning
  nsExec::ExecToStack 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$$p=Get-Process -Name vlc -ErrorAction SilentlyContinue; if ($$null -eq $$p) { exit 1 } else { exit 0 }"'
  Pop $0
  Pop $1
  ${If} $0 == "0"
    Push 1
  ${ElseIf} $0 == "1"
    Push 0
  ${Else}
    Push 1
  ${EndIf}
FunctionEnd


; Stop only worker processes whose executable path belongs to this installation.
; The wait stays inside PowerShell so the NSIS InstFiles section does not jump
; backwards and make the progress bar visibly retreat/advance.
; Returns 0 when all owned workers are gone, 1 on timeout, 2 on query failure.
; ------------------------------------------------------------------------------
Function StopOwnedWorkers
  nsExec::ExecToStack 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$$targets=@(''$INSTDIR\vlc-whisper-worker.exe'',''$INSTDIR\vlc-whisper-worker-cpu.exe''); $$names=@(''vlc-whisper-worker.exe'',''vlc-whisper-worker-cpu.exe''); try { $$owned=Get-CimInstance Win32_Process -ErrorAction Stop | Where-Object { $$_.Name -in $$names -and $$targets -contains $$_.ExecutablePath }; $$owned | ForEach-Object { Stop-Process -Id $$_.ProcessId -Force -ErrorAction SilentlyContinue }; for ($$i=0; $$i -lt 20; $$i++) { $$left=Get-CimInstance Win32_Process -ErrorAction Stop | Where-Object { $$_.Name -in $$names -and $$targets -contains $$_.ExecutablePath }; if ($$null -eq $$left) { exit 0 }; Start-Sleep -Milliseconds 200 }; exit 1 } catch { exit 2 }"'
  Pop $0
  Pop $1
  Push $0
FunctionEnd

Function un.StopOwnedWorkers
  nsExec::ExecToStack 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$$targets=@(''$INSTDIR\vlc-whisper-worker.exe'',''$INSTDIR\vlc-whisper-worker-cpu.exe''); $$names=@(''vlc-whisper-worker.exe'',''vlc-whisper-worker-cpu.exe''); try { $$owned=Get-CimInstance Win32_Process -ErrorAction Stop | Where-Object { $$_.Name -in $$names -and $$targets -contains $$_.ExecutablePath }; $$owned | ForEach-Object { Stop-Process -Id $$_.ProcessId -Force -ErrorAction SilentlyContinue }; for ($$i=0; $$i -lt 20; $$i++) { $$left=Get-CimInstance Win32_Process -ErrorAction Stop | Where-Object { $$_.Name -in $$names -and $$targets -contains $$_.ExecutablePath }; if ($$null -eq $$left) { exit 0 }; Start-Sleep -Milliseconds 200 }; exit 1 } catch { exit 2 }"'
  Pop $0
  Pop $1
  Push $0
FunctionEnd


; ------------------------------------------------------------------------------
; Section 1: Core Plugin, Worker & Models
; ------------------------------------------------------------------------------
Section "VLC Plugin & AI Engine" SecCore
  SectionIn RO

  DetailPrint "Checking for running VLC..."
  Call IsVLCProcessRunning
  Pop $0
  ${If} $0 == 1
    MessageBox MB_OKCANCEL|MB_ICONEXCLAMATION \
      "VLC is currently running. Please close VLC before installing.$\r$\nClick OK after closing VLC to continue, or Cancel to abort." \
      IDOK vlc_closed IDCANCEL vlc_abort
    vlc_closed:
      Call IsVLCProcessRunning
      Pop $0
      ${If} $0 == 1
        MessageBox MB_OK|MB_ICONSTOP "VLC is still running. Installation aborted to avoid terminating unrelated VLC instances. Please close VLC and run the installer again."
        SetErrorLevel 1
        Quit
      ${EndIf}
      Goto no_vlc_running
    vlc_abort:
      SetErrorLevel 1
      Quit
  ${EndIf}
  no_vlc_running:

  DetailPrint "Stopping owned worker processes..."
  Call StopOwnedWorkers
  Pop $0
  ${If} $0 != "0"
    DetailPrint "Could not confirm all owned workers stopped; locked binaries will be staged for reboot-safe replacement."
  ${EndIf}

  ; Stage the new plugin before touching the installed copy. If the old DLL is
  ; locked, schedule delete-then-rename so a failed upgrade cannot reboot into
  ; an installation where the old file was deleted without a replacement.
  SetOutPath "$INSTDIR\plugins\audio_filter"
  ClearErrors
  Delete "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll.vw-new"
  File /oname=libvlc_whisper_plugin.dll.vw-new "@VW_STAGE_DIR@/libvlc_whisper_plugin.dll"
  ${If} ${Errors}
    MessageBox MB_OK|MB_ICONSTOP "Failed to stage the plugin DLL for installation."
    Abort "Plugin DLL staging failed"
  ${EndIf}
  ClearErrors
  Delete "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll"
  ${If} ${FileExists} "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll"
    ClearErrors
    Delete /REBOOTOK "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll"
    Rename /REBOOTOK "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll.vw-new" "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll"
    ${If} ${Errors}
      MessageBox MB_OK|MB_ICONSTOP "Failed to schedule plugin DLL replacement on reboot."
      Abort "Plugin DLL reboot replacement failed"
    ${EndIf}
    DetailPrint "Plugin DLL is locked; replacement is staged for reboot."
    SetRebootFlag true
  ${Else}
    ClearErrors
    Rename "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll.vw-new" "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll"
    ${If} ${Errors}
      MessageBox MB_OK|MB_ICONSTOP "Failed to install plugin DLL."
      Abort "Plugin DLL install failed"
    ${EndIf}
  ${EndIf}

  SetOutPath "$INSTDIR"

  ; GPU worker is staged when present. The production GPU preset requires it;
  ; explicit CPU-only packages intentionally have no canonical GPU worker.
  ClearErrors
  Delete "$INSTDIR\vlc-whisper-worker.exe.vw-new"
  File /nonfatal /oname=vlc-whisper-worker.exe.vw-new "@VW_STAGE_DIR@/vlc-whisper-worker.exe"
  ${If} ${Errors}
    MessageBox MB_OK|MB_ICONSTOP "Failed to stage the GPU worker."
    Abort "GPU worker staging failed"
  ${EndIf}
  ${If} ${FileExists} "$INSTDIR\vlc-whisper-worker.exe.vw-new"
    ClearErrors
    Delete "$INSTDIR\vlc-whisper-worker.exe"
    ${If} ${FileExists} "$INSTDIR\vlc-whisper-worker.exe"
      ClearErrors
      Delete /REBOOTOK "$INSTDIR\vlc-whisper-worker.exe"
      Rename /REBOOTOK "$INSTDIR\vlc-whisper-worker.exe.vw-new" "$INSTDIR\vlc-whisper-worker.exe"
      ${If} ${Errors}
        MessageBox MB_OK|MB_ICONSTOP "Failed to schedule GPU worker replacement on reboot."
        Abort "GPU worker reboot replacement failed"
      ${EndIf}
      SetRebootFlag true
    ${Else}
      ClearErrors
      Rename "$INSTDIR\vlc-whisper-worker.exe.vw-new" "$INSTDIR\vlc-whisper-worker.exe"
      ${If} ${Errors}
        MessageBox MB_OK|MB_ICONSTOP "Failed to install GPU worker."
        Abort "GPU worker install failed"
      ${EndIf}
    ${EndIf}
  ${EndIf}

!if ${VW_PACKAGE_IS_GPU} == 0
  ; Runtime discovery prefers vlc-whisper-worker.exe. A CPU-only upgrade must
  ; remove any canonical GPU worker left by a previous GPU package so stale
  ; code can never outrank the freshly installed -cpu worker.
  ClearErrors
  Delete "$INSTDIR\vlc-whisper-worker.exe"
  ${If} ${FileExists} "$INSTDIR\vlc-whisper-worker.exe"
    Delete /REBOOTOK "$INSTDIR\vlc-whisper-worker.exe"
    SetRebootFlag true
  ${EndIf}
!endif

  ; CPU fallback is handled independently so GPU packages retain their
  ; loader-less fallback and CPU-only packages remain valid.
  ClearErrors
  Delete "$INSTDIR\vlc-whisper-worker-cpu.exe.vw-new"
  File /nonfatal /oname=vlc-whisper-worker-cpu.exe.vw-new "@VW_STAGE_DIR@/vlc-whisper-worker-cpu.exe"
  ${If} ${Errors}
    MessageBox MB_OK|MB_ICONSTOP "Failed to stage the CPU fallback worker."
    Abort "CPU worker staging failed"
  ${EndIf}
  ${If} ${FileExists} "$INSTDIR\vlc-whisper-worker-cpu.exe.vw-new"
    ClearErrors
    Delete "$INSTDIR\vlc-whisper-worker-cpu.exe"
    ${If} ${FileExists} "$INSTDIR\vlc-whisper-worker-cpu.exe"
      ClearErrors
      Delete /REBOOTOK "$INSTDIR\vlc-whisper-worker-cpu.exe"
      Rename /REBOOTOK "$INSTDIR\vlc-whisper-worker-cpu.exe.vw-new" "$INSTDIR\vlc-whisper-worker-cpu.exe"
      ${If} ${Errors}
        MessageBox MB_OK|MB_ICONSTOP "Failed to schedule CPU worker replacement on reboot."
        Abort "CPU worker reboot replacement failed"
      ${EndIf}
      SetRebootFlag true
    ${Else}
      ClearErrors
      Rename "$INSTDIR\vlc-whisper-worker-cpu.exe.vw-new" "$INSTDIR\vlc-whisper-worker-cpu.exe"
      ${If} ${Errors}
        MessageBox MB_OK|MB_ICONSTOP "Failed to install CPU fallback worker."
        Abort "CPU worker install failed"
      ${EndIf}
    ${EndIf}
  ${EndIf}

  ${IfNot} ${FileExists} "$INSTDIR\vlc-whisper-worker.exe"
  ${AndIfNot} ${FileExists} "$INSTDIR\vlc-whisper-worker.exe.vw-new"
  ${AndIfNot} ${FileExists} "$INSTDIR\vlc-whisper-worker-cpu.exe"
  ${AndIfNot} ${FileExists} "$INSTDIR\vlc-whisper-worker-cpu.exe.vw-new"
    MessageBox MB_OK|MB_ICONSTOP "No worker binary was installed or staged."
    Abort "No worker installed"
  ${EndIf}

  SetOutPath "$INSTDIR\models"
  File "@VW_STAGE_DIR@/models/manifest.json"
  File "@VW_STAGE_DIR@/models/ggml-tiny.bin"
  File "@VW_STAGE_DIR@/models/ggml-silero-vad.bin"

  SetOutPath "$INSTDIR\lua\extensions"
  File "@VW_STAGE_DIR@/lua/extensions/vlc_whisper_settings.lua"

  SetOutPath "$INSTDIR\vlc-whisper"
  File /oname=LICENSE-vlc-whisper.txt "@VW_STAGE_DIR@/LICENSE"
  File /oname=THIRD_PARTY_NOTICES-vlc-whisper.md "@VW_STAGE_DIR@/THIRD_PARTY_NOTICES.md"

  WriteRegStr HKLM "Software\VLC-Whisper" "InstallPath" "$INSTDIR"
  WriteRegStr HKLM "Software\VLC-Whisper" "Version" "@PROJECT_VERSION@"
  SetShellVarContext current
  StrCpy $INSTALL_USER_APPDATA "$LOCALAPPDATA\vlc-whisper"
  WriteRegStr HKLM "Software\VLC-Whisper" "InstallUserAppData" "$INSTALL_USER_APPDATA"
  SetShellVarContext all

  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\VLC-Whisper" "DisplayName" "VLC-Whisper AI Subtitle Plugin"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\VLC-Whisper" "DisplayVersion" "@PROJECT_VERSION@"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\VLC-Whisper" "Publisher" "VLC-Whisper Contributors"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\VLC-Whisper" "UninstallString" '"$INSTDIR\uninstall-vlc-whisper.exe"'
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\VLC-Whisper" "DisplayIcon" '"$INSTDIR\uninstall-vlc-whisper.exe",0'
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\VLC-Whisper" "InstallLocation" "$INSTDIR"
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\VLC-Whisper" "NoModify" 1
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\VLC-Whisper" "NoRepair" 1
  WriteUninstaller "$INSTDIR\uninstall-vlc-whisper.exe"

  CreateDirectory "$SMPROGRAMS\VLC-Whisper"
  CreateShortcut "$SMPROGRAMS\VLC-Whisper\VLC (with AI Whisper Captions).lnk" \
    "$INSTDIR\vlc.exe" '--audio-filter=vlc_whisper' "$INSTDIR\vlc.exe" 0
  CreateShortcut "$SMPROGRAMS\VLC-Whisper\Uninstall VLC-Whisper.lnk" \
    "$INSTDIR\uninstall-vlc-whisper.exe"
  CreateShortcut "$DESKTOP\VLC (with AI Whisper Captions).lnk" \
    "$INSTDIR\vlc.exe" '--audio-filter=vlc_whisper' "$INSTDIR\vlc.exe" 0

  DetailPrint "Invalidating VLC plugin cache (plugins.dat); VLC rebuilds it automatically on next launch."
  ClearErrors
  Delete "$INSTDIR\plugins\plugins.dat"
  ${If} ${Errors}
    Delete /REBOOTOK "$INSTDIR\plugins\plugins.dat"
  ${EndIf}

  ${If} ${RebootFlag}
    MessageBox MB_OK|MB_ICONEXCLAMATION "Some files were locked and will be replaced on next reboot. Please restart Windows before using VLC-Whisper."
  ${EndIf}

SectionEnd

; ------------------------------------------------------------------------------
; Uninstaller Implementation
; ------------------------------------------------------------------------------
Section "Uninstall"
  SetRegView 64
  SetShellVarContext all

  Call un.IsVLCProcessRunning
  Pop $0
  ${If} $0 == 1
    MessageBox MB_OKCANCEL|MB_ICONEXCLAMATION \
      "VLC is currently running. Please close VLC before uninstalling." \
      IDOK vlc_unst_closed IDCANCEL vlc_unst_abort
    vlc_unst_closed:
      Call un.IsVLCProcessRunning
      Pop $0
      ${If} $0 == 1
        MessageBox MB_OK|MB_ICONSTOP "VLC is still running. Uninstall aborted to avoid terminating unrelated VLC instances."
        SetErrorLevel 1
        Quit
      ${EndIf}
      Goto vlc_unst_ok
    vlc_unst_abort:
      SetErrorLevel 1
      Quit
  ${EndIf}
  vlc_unst_ok:

  DetailPrint "Stopping owned worker processes..."
  Call un.StopOwnedWorkers
  Pop $0
  ${If} $0 != "0"
    DetailPrint "Could not confirm all owned workers stopped; locked binaries will be removed on reboot if necessary."
  ${EndIf}

  ClearErrors
  Delete "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll"
  ${If} ${FileExists} "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll"
    Delete /REBOOTOK "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll"
    SetRebootFlag true
  ${EndIf}
  Delete "$INSTDIR\plugins\audio_filter\libvlc_whisper_plugin.dll.vw-new"

  ClearErrors
  Delete "$INSTDIR\vlc-whisper-worker.exe"
  ${If} ${FileExists} "$INSTDIR\vlc-whisper-worker.exe"
    Delete /REBOOTOK "$INSTDIR\vlc-whisper-worker.exe"
    SetRebootFlag true
  ${EndIf}
  Delete "$INSTDIR\vlc-whisper-worker.exe.vw-new"
  ClearErrors
  Delete "$INSTDIR\vlc-whisper-worker-cpu.exe"
  ${If} ${FileExists} "$INSTDIR\vlc-whisper-worker-cpu.exe"
    Delete /REBOOTOK "$INSTDIR\vlc-whisper-worker-cpu.exe"
    SetRebootFlag true
  ${EndIf}
  Delete "$INSTDIR\vlc-whisper-worker-cpu.exe.vw-new"

  Delete "$INSTDIR\models\ggml-tiny.bin"
  Delete "$INSTDIR\models\ggml-silero-vad.bin"
  Delete "$INSTDIR\models\manifest.json"
  RMDir "$INSTDIR\models"

  ReadRegStr $0 HKLM "Software\VLC-Whisper" "InstallUserAppData"
  ${If} $0 != ""
    DetailPrint "Removing model cache at stored location: $0"
    RMDir /r "$0\models"
    RMDir "$0"
    ${If} ${FileExists} "$0\*.*"
      RMDir /r /REBOOTOK "$0"
    ${EndIf}
  ${EndIf}

  Delete "$INSTDIR\lua\extensions\vlc_whisper_settings.lua"
  RMDir "$INSTDIR\lua\extensions"
  RMDir "$INSTDIR\lua"
  Delete "$INSTDIR\vlc-whisper\LICENSE-vlc-whisper.txt"
  Delete "$INSTDIR\vlc-whisper\THIRD_PARTY_NOTICES-vlc-whisper.md"
  RMDir "$INSTDIR\vlc-whisper"

  Delete "$SMPROGRAMS\VLC-Whisper\VLC (with AI Whisper Captions).lnk"
  Delete "$SMPROGRAMS\VLC-Whisper\Uninstall VLC-Whisper.lnk"
  RMDir "$SMPROGRAMS\VLC-Whisper"
  Delete "$DESKTOP\VLC (with AI Whisper Captions).lnk"

  ClearErrors
  Delete "$INSTDIR\uninstall-vlc-whisper.exe"
  ${If} ${FileExists} "$INSTDIR\uninstall-vlc-whisper.exe"
    Delete /REBOOTOK "$INSTDIR\uninstall-vlc-whisper.exe"
    SetRebootFlag true
  ${EndIf}
  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\VLC-Whisper"
  DeleteRegKey HKLM "Software\VLC-Whisper"

  DetailPrint "Invalidating VLC plugin cache; VLC rebuilds it automatically on next launch."
  ClearErrors
  Delete "$INSTDIR\plugins\plugins.dat"
  ${If} ${Errors}
    Delete /REBOOTOK "$INSTDIR\plugins\plugins.dat"
  ${EndIf}

  ${If} ${RebootFlag}
    MessageBox MB_OK|MB_ICONEXCLAMATION "Some files were locked and will be removed on next reboot. Please restart Windows."
  ${EndIf}
SectionEnd
